<?xml version="1.0" encoding="utf-8"?>
<!-- The icons over Art Mode, left to right. Each package entry may list several package names
     separated by "|"; the first one installed is used (SmartTube ships stable and beta builds). -->
<resources>
    <string-array name="app_labels">
        <item>Stremio</item>
        <item>SmartTube</item>
    </string-array>
    <string-array name="app_packages">
        <item>com.stremio.one</item>
        <item>org.smarttube.stable|com.teamsmart.videomanager.tv|com.liskovsoft.smarttubetv.beta|com.liskovsoft.smarttubetv</item>
    </string-array>
    <!-- A one-color version of each app's icon, drawn in AppGlyph.java. -->
    <string-array name="app_icons">
        <item>stremio</item>
        <item>youtube</item>
    </string-array>
</resources>
